NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional browser API origin override; leave unset for same-origin access.
# NUXT_PUBLIC_API_BASE=http://localhost:3000
# Optional Nuxt server proxy target; Docker Compose uses http://backend:3000.
# NUXT_PROXY_TARGET=http://localhost:3000
# Server target for streamed /mcp requests (same backend).
# NUXT_BACKEND_URL=http://localhost:3000
